# Copy to .env for local use, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Public site address, used for canonical URLs, sitemap and social previews.
# On Vercel this falls back to the production domain automatically.
SITE_URL=https://www.your-domain.com

# Square: live service catalogue (prices, durations, new/removed services).
# Square Developer Dashboard → your app → Production → Access token. Needs ITEMS_READ.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=LBRQ3J5MYKNYX
# SQUARE_ENVIRONMENT=sandbox

# Contact form email delivery (https://resend.com). Both are required for the form to send.
RESEND_API_KEY=
CONTACT_TO_EMAIL=ohitsdiscosundays@gmail.com
# A sender on a domain you've verified in Resend, e.g. "Maryland Recording Studio <hello@your-domain.com>"
CONTACT_FROM_EMAIL=

# Instagram feed on the Social page (Business/Creator account, long-lived token).
INSTAGRAM_ACCESS_TOKEN=

# Optional: more than 15 YouTube videos (the public feed works without a key).
YOUTUBE_API_KEY=
